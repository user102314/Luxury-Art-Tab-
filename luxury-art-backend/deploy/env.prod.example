# Copier vers /opt/luxury-art/.env puis : set -a; source .env; set +a
# java -jar luxury-art-backend-1.0.0.jar

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

# PostgreSQL / Supabase (obligatoire)
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.XXXX
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# Front déployé (domaine(s), séparés par des virgules)
APP_CORS_ALLOWED_ORIGINS=https://votredomaine.tn,https://www.votredomaine.tn

# Dossier images sur le VPS
APP_UPLOADS_DIR=/opt/luxury-art/uploads

# Colissimo (optionnel)
COLISSIMO_ENABLED=false
COLISSIMO_UTILISATEUR=
COLISSIMO_PASS=
